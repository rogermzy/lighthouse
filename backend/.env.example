# Copy this file to .env and fill in.
# See SETUP.md for the Google Cloud Console walkthrough.

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Required for the "Suggest from goals" Claude agent.
# Get one at https://console.anthropic.com — Settings → API Keys.
# Without this, the modal falls back to a deterministic local picker (still works,
# just not as smart). Per-click cost is well under a cent on Opus 4.7.
ANTHROPIC_API_KEY=

# ─── ClickUp ─────────────────────────────────────────────────────────────
# Personal API token from ClickUp → Apps → API Token (starts with "pk_").
# Team ID + User ID: easiest path is to open any task in your browser; the URL
# looks like https://app.clickup.com/{team_id}/v/li/... — and your user id shows
# under Settings → My Settings → User. Pull a recent task via curl to confirm:
#   curl -H "Authorization: $CLICKUP_API_TOKEN" \
#     "https://api.clickup.com/api/v2/team/$CLICKUP_TEAM_ID/task?assignees[]=$CLICKUP_USER_ID&include_closed=false" | head
CLICKUP_API_TOKEN=
CLICKUP_TEAM_ID=
CLICKUP_USER_ID=

# ─── Notion ──────────────────────────────────────────────────────────────
# Internal integration token: Notion → Settings → Integrations → New integration.
# Then open your tasks database, click "···" → Connect to → pick the integration.
# Database ID is in the URL: notion.so/<workspace>/{DATABASE_ID}?v=... (32 chars).
NOTION_API_KEY=
NOTION_TASKS_DB_ID=

# ─── Workflowy ───────────────────────────────────────────────────────────
# API key from Workflowy → Settings → API. Parent ID is the bullet whose
# children become Lighthouse tasks. Use "inbox" for Workflowy's inbox,
# "today" for the date-node, or a specific node id (last segment of a
# node URL like workflowy.com/#/abc123def456).
WORKFLOWY_API_KEY=
WORKFLOWY_PARENT_ID=inbox

# ─── Flomo ───────────────────────────────────────────────────────────────
# Two-way journal sync. Both fields optional — leave blank to disable.
#
# RSS pull: requires flomo PRO. Enable "私密 RSS" in flomo settings, copy
# the URL, paste it here. Memos sync into the journal every 5 min.
FLOMO_RSS_URL=
#
# Webhook push: every journal entry you log in Lighthouse gets pushed to
# flomo as a memo (tagged #lighthouse + #<mood>). Get the URL from flomo
# settings → API & 集成 → 增量 API. The #lighthouse tag prevents the
# RSS pull from re-importing what we just pushed.
FLOMO_WEBHOOK_URL=

# ─── Things 3 ────────────────────────────────────────────────────────────
# No config needed. Mac-only. If Things 3 is installed, the connector auto-enables
# and shells out to osascript every 5 min for open to-dos.

# Optional — defaults to http://127.0.0.1:7373/auth/google/callback.
# Must exactly match an Authorized Redirect URI in your OAuth client.
# GOOGLE_REDIRECT_URI=

# Optional — the Gmail label whose messages get pulled into the brain dump.
# Create this label in Gmail and apply it to anything you want to triage.
# Default is "Lighthouse". Starred messages are NOT auto-pulled — labeling
# is explicit intent, starring is overloaded with too many other meanings.
# GMAIL_TRIAGE_LABEL=Lighthouse

# Optional — change the port the server binds to.
# PORT=7373
